{
  "name": "remark-obsidian-md",
  "version": "2.0.0",
  "author": "Adriano Araújo (adrianoaraujodsantos@hotmail.com)",
  "description": "Remark plugin to support Obsidian.md syntax (wiki links, highlights)",
  "license": "MIT",
  "keywords": [
    "remark",
    "remark-plugin",
    "markdown",
    "obsidian",
    "unified",
    "wiki-links",
    "fumadocs",
    "hast"
  ],
  "homepage": "https://github.com/adrianoaraujods/remark-obsidian-md#readme",
  "repository": "https://github.com/adrianoaraujods/remark-obsidian-md",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "styles"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./styles/*": "./styles/*.css"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest --coverage",
    "prepublishOnly": "npm run build",
    "lint": "biome check",
    "format": "biome format --write",
    "prepare": "husky"
  },
  "dependencies": {
    "mdast-util-find-and-replace": "^3.0.2",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.13",
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@types/js-yaml": "^4.0.9",
    "@types/mdast": "^4.0.4",
    "@types/node": "^25.2.0",
    "@types/unist": "^3.0.3",
    "@vitest/coverage-v8": "^4.0.18",
    "husky": "^9.1.7",
    "remark-parse": "^11.0.0",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "unist-util-select": "^5.1.0"
  }
}
